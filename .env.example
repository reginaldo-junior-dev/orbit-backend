# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
# Used by docker-compose.yml.

# Postgres (the "postgres" service creates this db/user/password on first run)
POSTGRES_DB=orbit
POSTGRES_USER=orbit
POSTGRES_PASSWORD=

# Generate a long random value, e.g.: openssl rand -base64 48
JWT_SECRET=

# Mercado Pago TEST credentials only — see README's "Payment testing" section
# for how to get these. Never put a production access token here.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Optional: only needed if you're testing the webhook end-to-end, which
# requires a publicly reachable URL (e.g. an ngrok tunnel). Leave blank to
# just run the app locally without live payment status updates.
MP_NOTIFICATION_URL=

# Optional: seeded demo accounts (skipped if left blank)
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
